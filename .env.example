# Copy this file to .env for local development.
# Replace ADMIN_API_TOKEN and APP_ENCRYPTION_KEY before using the app.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

POSTGRES_USER=hookguard
POSTGRES_PASSWORD=hookguard_local_only_change_me
POSTGRES_DB=hookguard
DATABASE_URL=postgresql://hookguard:hookguard_local_only_change_me@localhost:5432/hookguard

RABBITMQ_USER=hookguard
RABBITMQ_PASSWORD=hookguard_rabbit_local_change_me
RABBITMQ_URL=amqp://hookguard:hookguard_rabbit_local_change_me@localhost:5672

REDIS_PASSWORD=hookguard_redis_local_change_me
REDIS_URL=redis://:hookguard_redis_local_change_me@localhost:6379

# Generate a fresh 32-byte key using:
# openssl rand -hex 32
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

ADMIN_API_TOKEN=local-admin-token-change-this
INGRESS_BASE_URL=http://localhost:3000

# Local-only option for testing with the Docker webhook sink.
# Disable this in production and implement appropriate network egress controls.
ALLOW_PRIVATE_DESTINATIONS=true

INGRESS_RATE_LIMIT_PER_MINUTE=20000

DESTINATION_TIMEOUT_MS=10000
MAX_DELIVERY_ATTEMPTS=8
RETRY_BASE_MS=1000
RETRY_MAX_MS=60000

WORKER_CONCURRENCY=20
WORKER_LEASE_MS=60000

OUTBOX_POLL_MS=300
SCHEDULER_POLL_MS=1000
WORKER_METRICS_PORT=9101

# Correctness and load-testing configuration
HOOKGUARD_BASE_URL=http://localhost:3000
CHECKER_DESTINATION_URL=http://webhook-sink:4001/webhook
CHECKER_OPERATIONS=10000
CHECKER_CONCURRENCY=100
CHECKER_SEED=20261029

# Toxiproxy
TOXIPROXY_API_URL=http://localhost:8474
TOXIPROXY_UPSTREAM=webhook-sink:4001